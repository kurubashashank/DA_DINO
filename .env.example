# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
# Vite only: for a split Vercel + Render deployment, append /api to your Render URL.
VITE_API_URL=http://localhost:5000/api
# Intro options: first-visit (default), session, always, disabled.
VITE_INTRO_PLAYBACK=first-visit
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/dino-print-house
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_MAX_POOL_SIZE=10
JWT_SECRET=replace-with-a-long-random-secret
# In production, cookies are always Secure. Use "none" for a Vercel + Render
# split deployment, or "lax" when storefront and API share one custom domain.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# One-time admin bootstrap (remove these after creating the first admin)
ALLOW_ADMIN_SETUP=false
ADMIN_SETUP_KEY=replace-with-a-long-random-key
# Optional: set true only while explicitly onboarding a trusted administrator.
# Turn it back to false immediately after the account has been created.
ALLOW_ADMIN_SIGNUP=false
ADMIN_SIGNUP_KEY=replace-with-a-different-long-random-key

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (optional until paid checkout is enabled)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
